Output assets/demo.gif

Require ./target/release/rovee

Set Shell "bash"
Set FontFamily "MonoLisa Nerd Font"
Set FontSize 14
Set Width 1600
Set Height 1000
Set Padding 24
Set WindowBar Colorful
Set BorderRadius 10
Set Theme { "name": "vague", "black": "#252530", "red": "#d8647e", "green": "#7fa563", "yellow": "#f3be7c", "blue": "#6e94b2", "magenta": "#bb9dbd", "cyan": "#aeaed1", "white": "#cdcdcd", "brightBlack": "#606079", "brightRed": "#e08398", "brightGreen": "#99b782", "brightYellow": "#f5cb96", "brightBlue": "#8ba9c1", "brightMagenta": "#c9b1ca", "brightCyan": "#bebeda", "brightWhite": "#d7d7d7", "background": "#141415", "foreground": "#cdcdcd", "selection": "#252530", "cursor": "#cdcdcd" }

Hide
Type "./target/release/rovee"
Enter
Sleep 3.5s
Show

Sleep 2s

Tab
Sleep 1s

Down
Sleep 600ms
Enter
Sleep 1.5s
Enter
Sleep 1.5s

Down
Sleep 600ms
Enter
Sleep 1s
Type@450ms "LLLLLLL"
Sleep 1.2s
Type@450ms "HHHHHHH"
Sleep 1s
Escape
Sleep 800ms

Down
Sleep 600ms
Left@350ms 5
Sleep 1s
Right@350ms 5
Sleep 1s

Down
Sleep 600ms
Enter
Sleep 1s
Enter
Sleep 1.8s
Down@300ms 3
Sleep 400ms
Enter
Sleep 1.8s
Down
Sleep 400ms
Enter
Sleep 1.8s
Escape
Sleep 800ms

Type "1"
Sleep 1.8s
Type "2"
Sleep 1.8s

Tab
Sleep 800ms
Down
Sleep 800ms
Type "1"
Sleep 2s
Up
Sleep 1s

Type "t"
Sleep 600ms
Type@120ms "HHHHHHHHHHHHHHHH"
Sleep 600ms
Escape
Sleep 500ms
Type@150ms "++++++++++"
Sleep 2s

Type "q"
Sleep 500ms
